---
import Base from '../layouts/Base.astro';
import { base, navigation } from '../nav';

const { sections } = await navigation();
---
<Base title="Documentación">
  <h1>Platformer: documentación del proyecto</h1>
  <p class="lead">Un plataformas 2D en C++20 y SDL3, explicado para entenderlo y aprender con él.</p>
  <p>
    Si es tu primera vez, empieza por <a href={`${base}introduccion/`}>Introducción</a> y sigue con los enlaces del
    final de cada página. Si C++ te suena nuevo, ten a mano <a href={`${base}cpp-para-novatos/`}>C++ para novatos</a>.
  </p>
  {sections.map((section) => (
    <>
      <h2>{section.title}</h2>
      <ul>
        {section.pages.map((p) => (
          <li><a href={`${base}${p.id}/`}>{p.data.title}</a>: {p.data.summary}</li>
        ))}
      </ul>
    </>
  ))}
</Base>
