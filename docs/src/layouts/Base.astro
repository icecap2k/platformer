---
interface Props { title: string }
const { title } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Platformer</title>
    <style is:global>
      :root { color-scheme: light dark; }
      body { font-family: system-ui, sans-serif; max-width: 46rem; margin: 0 auto; padding: 1.5rem; line-height: 1.65; }
      header { border-bottom: 1px solid #8884; margin-bottom: 2rem; padding-bottom: .5rem; }
      header a { font-weight: 700; text-decoration: none; }
      pre { padding: 1rem; overflow-x: auto; border-radius: 6px; }
      code { font-size: .9em; }
      .epic { font-size: .8rem; opacity: .7; text-transform: uppercase; letter-spacing: .05em; }
    </style>
  </head>
  <body>
    <header><a href={import.meta.env.BASE_URL}>🎮 Platformer · Diario de desarrollo</a></header>
    <slot />
  </body>
</html>
